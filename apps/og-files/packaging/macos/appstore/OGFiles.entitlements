<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store: sandboxed. Settings, history and caches live in the
       app's container. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Folders the user grants in the open panel ("Grant Access…"), kept
       across launches as security-scoped bookmarks (src/macos.rs). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- The usual media folders work without asking first. -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <key>com.apple.security.assets.pictures.read-write</key>
  <true/>
  <key>com.apple.security.assets.music.read-write</key>
  <true/>
  <key>com.apple.security.assets.movies.read-write</key>
  <true/>
  <!-- Convert to PDF: fetching a web page, or images an HTML/Markdown
       file links to. Nothing else uses the network. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Must match the provisioning profile. -->
  <key>com.apple.application-identifier</key>
  <string>FGFW7ZAJUC.com.omegagiven.ogfiles</string>
  <key>com.apple.developer.team-identifier</key>
  <string>FGFW7ZAJUC</string>
</dict>
</plist>
