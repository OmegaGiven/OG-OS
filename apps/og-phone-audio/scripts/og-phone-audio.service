[Unit]
Description=OG Phone Audio relay (PC audio -> phone -> headphones)
After=pipewire.service pipewire-pulse.service wireplumber.service network-online.target
PartOf=pipewire.service

[Service]
Type=simple
# Dev build in ~/.local/bin wins, else the packaged /usr/bin copy.
ExecStart=/bin/sh -c 'b=%h/.local/bin/og-phone-audio; [ -x "$$b" ] || b=/usr/bin/og-phone-audio; exec "$$b"'
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=default.target
