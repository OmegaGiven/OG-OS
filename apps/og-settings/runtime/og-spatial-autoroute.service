[Unit]
Description=OG Spatial auto-router (multichannel playback -> HRTF sink)
After=pipewire.service pipewire-pulse.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
# Dev build in ~/.local/bin wins, else the packaged /usr/bin copy (same
# rule as og_config::og_bin) — one unit file for both layouts.
ExecStart=/bin/sh -c 'b=%h/.local/bin/og-spatial-autoroute; [ -x "$$b" ] || b=/usr/bin/og-spatial-autoroute; exec "$$b"'
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=default.target
