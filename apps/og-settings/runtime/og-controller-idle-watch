#!/usr/bin/env python3
"""Keeps swayidle's timeout from firing while a gamepad is actively being
used. swayidle only resets on Wayland-seat keyboard/pointer activity; raw
evdev joystick input never reaches it, so controller-only sessions (e.g.
Steam gameplay) get idle-locked/suspended out from under the user. This
watches the controller's own event device and re-spawns swayidle (which
restarts its internal timeout clock) on activity, debounced so it doesn't
spawn a subprocess on every single button/axis event.
"""
import os
import re
import select
import subprocess
import time

import evdev

DEBOUNCE_SECONDS = 20
POWER_APPLY = os.path.expanduser("~/.local/bin/og-power-apply")


def find_gamepad():
    """Match the main gamepad node (Handlers containing a jsN entry),
    skipping xpadneo's synthetic keyboard/mouse/consumer-control
    sub-devices which would otherwise trigger on non-game input."""
    try:
        blocks = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        return None
    for block in blocks:
        handlers_line = next((l for l in block.splitlines() if l.startswith("H: Handlers=")), None)
        if not handlers_line or not re.search(r"\bjs\d+\b", handlers_line):
            continue
        m = re.search(r"\bevent(\d+)\b", handlers_line)
        if not m:
            continue
        candidate = f"/dev/input/event{m.group(1)}"
        try:
            return evdev.InputDevice(candidate)
        except (OSError, PermissionError):
            continue
    return None


def reset_idle_timer():
    subprocess.run([POWER_APPLY], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def watch(dev):
    last_reset = 0.0
    while True:
        r, _, _ = select.select([dev.fd], [], [], 5.0)
        if not r:
            continue
        try:
            events = list(dev.read())
        except OSError:
            return  # device disconnected — go back to searching
        if not events:
            continue
        now = time.monotonic()
        if now - last_reset >= DEBOUNCE_SECONDS:
            reset_idle_timer()
            last_reset = now


def main():
    while True:
        dev = find_gamepad()
        if dev is None:
            time.sleep(5)
            continue
        try:
            watch(dev)
        except Exception:
            time.sleep(5)


if __name__ == "__main__":
    main()
