#!/usr/bin/env node
/*
 * og-spatial-autoroute — route multichannel (>2ch) playback through the
 * OG Spatial HRTF sink automatically; keep stereo on the real device.
 *
 * ~/.local/state/spatial-mode:  auto | always | off   (default auto)
 *   auto   - 5.1/7.1 stream -> HRTF, stereo stream -> real device
 *   always - every stream -> HRTF
 *   off    - route nothing (HRTF sink may still be loaded, just idle)
 *
 * The HRTF sink is created/kept by `spatial load`; this only moves
 * sink-inputs. Runs as a systemd --user service.
 */
'use strict';
const { execSync, execFileSync, spawn } = require('child_process');
const fs = require('fs');
const os = require('os');

const SINK = 'effect_input.og-spatial';
const HOME = os.homedir();
const MODE_F = `${HOME}/.local/state/spatial-mode`;
const PRESET_F = `${HOME}/.local/state/spatial-preset`;
// execSync runs under /bin/sh, which never has ~/.local/bin on PATH (same
// gotcha as sway/waybar) — always call this by absolute path or every
// invocation below silently no-ops with "command not found". Dev build in
// ~/.local/bin wins, else the packaged copy (og_config::og_bin rule).
const SPATIAL = (() => {
  const dev = `${HOME}/.local/bin/spatial`;
  try { fs.accessSync(dev, fs.constants.X_OK); return dev; } catch { return '/usr/bin/spatial'; }
})();

const sh = (c) => { try { return execSync(c, { encoding: 'utf8', timeout: 8000 }); } catch { return ''; } };
const pactlJSON = (what) => { try { return JSON.parse(sh(`pactl -f json list ${what}`)); } catch { return []; } };

const mode = () => (fs.readFileSync(MODE_F, 'utf8').trim() || 'auto');
const readMode = () => { try { return mode(); } catch { return 'auto'; } };

function realDefault() {
  // the device the HRTF chain is pinned to, else the live default, else first real sink
  const pinned = sh(`${SPATIAL} _hw`).trim();
  if (pinned && pinned !== SINK) return pinned;
  const def = sh('pactl get-default-sink').trim();
  if (def && def !== SINK) return def;
  const first = pactlJSON('sinks').map((s) => s.name).find((n) => !n.startsWith('effect_'));
  return first || '';
}

function sinkPresent() {
  return pactlJSON('sinks').some((s) => s.name === SINK);
}

function ensureSink() {
  if (sinkPresent()) return true;
  sh(`${SPATIAL} load ${fs.existsSync(PRESET_F) ? fs.readFileSync(PRESET_F, 'utf8').trim() : 'atmos'}`);
  for (let i = 0; i < 15; i++) {
    if (sinkPresent()) return true;
    execSync('sleep 0.2');
  }
  return false;
}

// ---- follow the headset ----------------------------------------------------
// The headset plugs into one of two places: the onboard front jack (has jack
// sense) or the ATR USB mic's monitor jack (no sense, "availability unknown").
// WirePlumber turns the onboard card's profile OFF whenever the front jack
// reads unplugged and does not reliably turn it back on, so the default kept
// collapsing onto whatever sink was left and streams (Brave) followed it.
// We own that decision instead: wake the onboard card when its headphone jack
// is live, rank the outputs, and on a plug/unplug *transition* make the best
// one default, move stereo streams to it and repin the HRTF chain. Between
// transitions the default is left alone so a manual pick (og-settings "Set
// Default") sticks.
let lastPreferred = null;

const hpLive = (ports) => (ports || []).some((p) =>
  /headphones/.test(p.name) && p.availability === 'available');

function wakeOnboard() {
  for (const c of pactlJSON('cards')) {
    if (!c.name.startsWith('alsa_card.pci-') || c.active_profile !== 'off') continue;
    const hp = c.ports && c.ports['analog-output-headphones'];
    if (!hp || hp.availability !== 'available') continue;
    if (!(c.profiles && c.profiles['output:analog-stereo'])) continue;
    try { execFileSync('pactl', ['set-card-profile', c.name, 'output:analog-stereo']); } catch {}
  }
}

function preferredSink() {
  // 4: a connected Bluetooth headset/headphones (AirPods, ...) — the
  //    sink only exists while it's connected, so connecting one takes
  //    the audio and disconnecting falls back to the wired ranking
  // 3: onboard analog with headphones plugged in
  // 2: any USB analog output (ATR monitor jack, G935, ...)
  // 1: anything else real (HDMI monitor speakers)
  // 0: onboard analog with nothing plugged in
  const score = (s) => {
    if (s.name.startsWith('effect_')) return -1;
    if (s.name.startsWith('bluez_output.')) return 4;
    if (!s.name.startsWith('alsa_output.')) return -1;
    const analog = /analog/.test(s.name);
    if (s.name.startsWith('alsa_output.pci-') && analog) return hpLive(s.ports) ? 3 : 0;
    if (s.name.startsWith('alsa_output.usb-') && analog) return 2;
    return 1;
  };
  const ranked = pactlJSON('sinks').map((s) => [score(s), s.name]).filter(([n]) => n >= 0);
  if (!ranked.length) return '';
  const best = Math.max(...ranked.map(([n]) => n));
  const top = ranked.filter(([n]) => n === best).map(([, name]) => name);
  const def = sh('pactl get-default-sink').trim();
  return top.includes(def) ? def : top[0];
}

function followHeadset(m) {
  wakeOnboard();
  const want = preferredSink();
  if (!want || want === lastPreferred) return;
  lastPreferred = want;

  if (m !== 'always') {
    try { execFileSync('pactl', ['set-default-sink', want]); } catch {}
    try { execFileSync('pw-metadata', ['0', 'default.configured.audio.sink', `{ "name": "${want}" }`]); } catch {}
  }
  if (m !== 'off' && sinkPresent() && sh(`${SPATIAL} _hw`).trim() !== want) {
    sh(`${SPATIAL} load "" ${want}`);
  }
  const sinks = Object.fromEntries(pactlJSON('sinks').map((s) => [s.index, s.name]));
  for (const si of pactlJSON('sink-inputs')) {
    const cur = sinks[si.sink] || '';
    if (cur === SINK || cur === want) continue;
    try { execFileSync('pactl', ['move-sink-input', String(si.index), want]); } catch {}
  }
}

function reroute() {
  const m = readMode();
  followHeadset(m);
  if (m === 'off') return;
  if (!ensureSink()) return;
  const hw = realDefault();

  // keep the *default* sink sane: in auto mode it must be the real device
  // (only 5.1/7.1 goes to the HRTF sink, by move); in always mode it is the
  // HRTF sink so new streams land there.
  const def = sh('pactl get-default-sink').trim();
  if (m === 'auto' && def === SINK && hw) {
    execSync(`pactl set-default-sink ${hw}`);
    try { execFileSync('pw-metadata', ['0', 'default.configured.audio.sink', `{ "name": "${hw}" }`]); } catch {}
  } else if (m === 'always' && def !== SINK) {
    try { execSync(`pactl set-default-sink ${SINK}`); } catch {}
  }

  const sinks = Object.fromEntries(pactlJSON('sinks').map((s) => [s.index, s.name]));

  for (const si of pactlJSON('sink-inputs')) {
    const idx = si.index;
    const cur = sinks[si.sink] || '';
    const ch = String(si.channel_map || '').split(',').filter(Boolean).length;
    const move = (to) => { if (to && cur !== to) { try { execFileSync('pactl', ['move-sink-input', String(idx), to]); } catch {} } };

    if (m === 'always') {
      move(SINK);
    } else { // auto
      if (ch > 2) move(SINK);
      else if (cur === SINK) move(hw);
    }
  }
}

// initial sweep
reroute();

// react to sink-input / sink changes, coalesced
let timer = null;
const bump = () => { clearTimeout(timer); timer = setTimeout(reroute, 300); };

const sub = spawn('pactl', ['subscribe'], { stdio: ['ignore', 'pipe', 'ignore'] });
sub.stdout.on('data', (buf) => {
  for (const line of buf.toString().split('\n')) {
    if (/on sink-input|on sink\b|on card\b/.test(line)) bump();
  }
});
sub.on('exit', () => process.exit(1)); // let systemd restart us
