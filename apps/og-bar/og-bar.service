[Unit]
Description=og-bar — Wayland layer-shell status bar
PartOf=graphical-session.target
After=graphical-session.target
# Don't give up after repeated fast restarts (e.g. a suspend/resume storm).
StartLimitIntervalSec=0

[Service]
Type=simple
# Dev build in ~/.local/bin wins, else the packaged /usr/bin copy (same
# rule as og_config::og_bin) — one unit file for both layouts. `exec` keeps
# og-bar itself as the main PID, which NotifyAccess=main/WatchdogSec need.
ExecStart=/bin/sh -c 'b=%h/.local/bin/og-bar; [ -x "$$b" ] || b=/usr/bin/og-bar; exec "$$b"'
# Layer-shell clients are fragile across DPMS/suspend/output hotplug; if the
# bar dies (crash on resume, Wayland disconnect) bring it straight back.
Restart=always
RestartSec=1
# Hang detection: og-bar pings WATCHDOG=1 every 10s from inside its event
# loop (src/watchdog.rs). A frozen loop (e.g. a present blocked on a dead
# layer surface) stops pinging and gets killed + restarted here — a live
# PID alone isn't proof of life.
WatchdogSec=45
NotifyAccess=main
Environment=RUST_BACKTRACE=1
TimeoutStopSec=5
Slice=session.slice

[Install]
WantedBy=graphical-session.target
