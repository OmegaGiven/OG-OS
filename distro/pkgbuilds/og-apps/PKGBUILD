# Maintainer: OmegaGiven
# Source repo is app-store; binary/pkg name is og-apps. Built on the dev
# machine, not inside the archiso chroot — see og-os/OS-PLAN.md phase 2.
# No install.sh existed in-repo; package() written from scratch against
# Cargo.toml's [[bin]] name (repo README says app-manager — stale, wrong).
# Sources via rsync from $_ogsrc (the live working tree when built locally, the
# checked-out commit in CI), not git — these repos
# carry uncommitted work a git+file:// clone would silently drop.
pkgname=og-apps
# Source tree: $OGOS_SRC if set (CI sets it to the checked-out commit),
# else the repo this PKGBUILD lives in. Version: $OGOS_PKGVER if set (CI
# derives a monotonic one from git), else the static fallback below.
_ogsrc="${OGOS_SRC:-$(cd "$startdir/../../.." && pwd)}"
pkgver="${OGOS_PKGVER:-20260908}"
pkgrel=1
pkgdesc="OG-toolkit pacman/AUR/Flatpak app store GUI"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-OS"
license=('MIT')
depends=('gcc-libs' 'wayland' 'pacman' 'yay' 'flatpak')
makedepends=('cargo' 'rsync')
source=()

prepare() {
  rsync -a --exclude target --exclude .git --exclude pkg --exclude distro "$_ogsrc/" "$srcdir/OG-toolkit/"
}

build() {
  cd "$srcdir/OG-toolkit/apps/og-apps"
  cargo build --release
}

package() {
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/OG-toolkit/target}/release/og-apps" "$pkgdir/usr/bin/og-apps"
}
