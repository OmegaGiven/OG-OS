# Maintainer: OmegaGiven
# OG Files (apps/og-files): file manager with built-in viewers/editors
# (PDF toolkit, audio, video, spreadsheets, archives, documents, 3D). Built
# on the dev machine, not inside the archiso chroot — see og-os/OS-PLAN.md
# phase 2. The og-suite feature (suite theme + Wayland drag-and-drop) is
# the crate default. Video uses the FFmpeg *libraries*, audio goes out via
# ALSA (pipewire-alsa), drives via the udisks2 D-Bus service, 3D via wgpu.
# Builds straight from $_ogsrc (the live working tree when built locally, the
# checked-out commit in CI), not git — these repos
# carry uncommitted work a git+file:// clone would silently drop.
pkgname=og-files
# Source tree: $OGOS_SRC if set (CI sets it to the checked-out commit),
# else the repo this PKGBUILD lives in. Version: $OGOS_PKGVER if set (CI
# derives a monotonic one from git), else the static fallback below.
_ogsrc="${OGOS_SRC:-$(cd "$startdir/../../.." && pwd)}"
pkgver="${OGOS_PKGVER:-20260908}"
pkgrel=1
pkgdesc="OG Files: file manager with built-in viewers and editors"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-OS"
license=('MPL-2.0')
# mpv provides libmpv (the video engine, loaded at runtime); libva + mesa
# give hardware decoding on AMD (radeonsi) out of the box
depends=('gcc-libs' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'ffmpeg' 'alsa-lib' 'udisks2'
         'mpv' 'libva' 'mesa'
         'rclone' 'fuse3')  # network storage: user-level mounts under ~/Network
optdepends=('pipewire-alsa: route audio through PipeWire'
            'intel-media-driver: hardware video decoding on Intel (Broadwell and newer)'
            'libva-intel-driver: hardware video decoding on older Intel GPUs'
            'libva-nvidia-driver: hardware video decoding on NVIDIA with the proprietary driver')
makedepends=('cargo' 'clang')  # clang: bindgen for the FFmpeg bindings
# No split -debug package: its RUSTFLAGS path remap differs per package,
# which would make every package rebuild the shared cargo target from
# scratch (and build-repo.sh drops -debug packages anyway).
options=('!debug')
source=()

build() {
  # Builds every packaged app (../workspace-apps) straight from the source
  # tree in one go: all og-* packages share that one build (and, via
  # build-repo.sh, one CARGO_TARGET_DIR), so the 2nd..nth are no-ops.
  local apps=()
  mapfile -t apps < <(grep -v '^#' "$startdir/../workspace-apps")
  cd "$_ogsrc"
  cargo build --release --locked "${apps[@]/#/--package=}"
}

package() {
  install -Dm755 "${CARGO_TARGET_DIR:-$_ogsrc/target}/release/og-files" "$pkgdir/usr/bin/og-files"
  local p="$_ogsrc/apps/og-files/packaging"
  install -Dm644 "$p/linux/og-files.desktop" "$pkgdir/usr/share/applications/og-files.desktop"
  install -Dm644 "$p/linux/com.omegagiven.ogfiles.metainfo.xml" "$pkgdir/usr/share/metainfo/com.omegagiven.ogfiles.metainfo.xml"
  install -Dm644 "$p/icons/og-files.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/og-files.png"
  install -Dm644 "$p/icons/og-files.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/og-files.svg"
  install -Dm644 "$_ogsrc/apps/og-files/LICENSE" "$pkgdir/usr/share/licenses/og-files/LICENSE"
}
