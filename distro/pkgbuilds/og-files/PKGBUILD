# Maintainer: OmegaGiven
# Source repo is file-manager; binary/pkg name is og-files. Built on the
# dev machine, not inside the archiso chroot — see og-os/OS-PLAN.md
# phase 2. ffmpeg/zip/unzip/tar/alacritty are optional runtime deps
# (video thumbs, archive ops, terminal spawn) — left out of depends,
# already covered by base's everyday-utilities group or user config.
# Builds straight from $_ogsrc (the live working tree when built locally, the
# checked-out commit in CI), not git — these repos
# carry uncommitted work a git+file:// clone would silently drop.
pkgname=og-files
# Source tree: $OGOS_SRC if set (CI sets it to the checked-out commit),
# else the repo this PKGBUILD lives in. Version: $OGOS_PKGVER if set (CI
# derives a monotonic one from git), else the static fallback below.
_ogsrc="${OGOS_SRC:-$(cd "$startdir/../../.." && pwd)}"
pkgver="${OGOS_PKGVER:-20260908}"
pkgrel=1
pkgdesc="OG-toolkit file manager"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-OS"
license=('MIT')
depends=('gcc-libs' 'wayland' 'ttf-nerd-fonts-symbols' 'xdg-utils')
makedepends=('cargo')
# No split -debug package: its RUSTFLAGS path remap differs per package,
# which would make every package rebuild the shared cargo target from
# scratch (and build-repo.sh drops -debug packages anyway).
options=('!debug')
source=()

build() {
  # Builds every packaged app (../workspace-apps) straight from the source
  # tree in one go: all og-* packages share that one build (and, via
  # build-repo.sh, one CARGO_TARGET_DIR), so the 2nd..nth are no-ops.
  local apps=()
  mapfile -t apps < <(grep -v '^#' "$startdir/../workspace-apps")
  cd "$_ogsrc"
  cargo build --release --locked "${apps[@]/#/--package=}"
}

package() {
  install -Dm755 "${CARGO_TARGET_DIR:-$_ogsrc/target}/release/og-files" "$pkgdir/usr/bin/og-files"
}
