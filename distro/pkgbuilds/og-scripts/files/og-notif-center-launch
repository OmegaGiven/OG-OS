#!/bin/sh
# Wraps the og-notif-center binary so Escape closes it even when it's not
# the focused window — same mechanism and rationale as og-search-launch,
# coordinated with it via og-popup-escape-guard so the shared Escape bind
# only actually releases once neither popup is open anymore.
#
# Programs are resolved like og_config::og_bin: a dev build in
# ~/.local/bin wins, else the packaged /usr/bin copy (always a full path —
# sway's exec environment has no ~/.local/bin on PATH, and the guard's
# `pgrep -f '/og-notif-center$'` needs the slash).
og_bin() {
    if [ -x "$HOME/.local/bin/$1" ]; then echo "$HOME/.local/bin/$1"
    elif [ -x "/usr/bin/$1" ]; then echo "/usr/bin/$1"
    else command -v "$1" || echo "/usr/bin/$1"; fi
}

"$(og_bin og-popup-escape-guard)" acquire

"$(og_bin og-notif-center)"

"$(og_bin og-popup-escape-guard)" release
