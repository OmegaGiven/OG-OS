#!/bin/sh
# Wraps the og-search binary so Escape closes it even when it's not the
# focused window. Iced only sees key events while its own window has focus,
# so we grab a compositor-level Escape bind for the duration of the run and
# release it again once og-search exits (however it exits).
#
# Coordinated with og-notif-center-launch via og-popup-escape-guard — the
# same Escape bind covers both, so closing one doesn't un-hijack Escape
# out from under the other if it's still open.
#
# Programs are resolved like og_config::og_bin: a dev build in
# ~/.local/bin wins, else the packaged /usr/bin copy. Never a bare name —
# sway's exec environment has no ~/.local/bin on PATH — and always a full
# path, which og-popup-escape-guard's `pgrep -f '/og-search$'` relies on.
og_bin() {
    if [ -x "$HOME/.local/bin/$1" ]; then echo "$HOME/.local/bin/$1"
    elif [ -x "/usr/bin/$1" ]; then echo "/usr/bin/$1"
    else command -v "$1" || echo "/usr/bin/$1"; fi
}

"$(og_bin og-popup-escape-guard)" acquire

"$(og_bin og-search)"

"$(og_bin og-popup-escape-guard)" release
