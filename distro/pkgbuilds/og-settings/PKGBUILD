# Maintainer: OmegaGiven
# Built on the dev machine, not inside the archiso chroot — see
# OS-PLAN.md phase 2. Builds straight from $_ogsrc (the live working tree when built locally, the
# checked-out commit in CI), not git — the whole monorepo is one source tree now that og-settings
# (formerly sway-control) lives at apps/og-settings and its build deps
# (crates/, vendor/) are siblings in the same tree.
pkgname=og-settings
# Source tree: $OGOS_SRC if set (CI sets it to the checked-out commit),
# else the repo this PKGBUILD lives in. Version: $OGOS_PKGVER if set (CI
# derives a monotonic one from git), else the static fallback below.
_ogsrc="${OGOS_SRC:-$(cd "$startdir/../../.." && pwd)}"
pkgver="${OGOS_PKGVER:-20260908}"
pkgrel=1
pkgdesc="OG-toolkit control panel (theme, audio, network, printing, power, sysmonitor)"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-OS"
license=('MIT')
# Runtime tools og-settings and its helper scripts shell out to — missing
# ones made tabs/actions silently do nothing on a fresh install:
# sway (swaymsg), python (og-power-apply/og-opacity-apply), swayidle +
# swaylock (Power tab), libpulse/pipewire/alsa-utils (Audio tab: pactl,
# parec, pw-link, pw-play, speaker-test), pacman-contrib (Updates tab:
# checkupdates), usbutils/pciutils (Devices tab: lsusb, lspci),
# brightnessctl (Display), libnotify + mako (Notifications tab).
depends=('gcc-libs' 'wayland' 'btop' 'bluez' 'iwd'
         'sway' 'python' 'swayidle' 'swaylock' 'libpulse' 'pipewire' 'alsa-utils'
         'pacman-contrib' 'usbutils' 'pciutils' 'brightnessctl' 'libnotify' 'mako')
optdepends=('python-evdev: keep the screen awake while a gamepad is in use (og-controller-idle-watch)'
            'wireguard-tools: VPN tab (WireGuard configs via og-vpn-apply)'
            'tailscale: VPN tab (Tailscale exit nodes)'
            'cups: Printing tab'
            'xorg-xcursorgen: Theme tab cursor import'
            'librsvg: Theme tab cursor import from SVG'
            'imagemagick: Theme tab cursor import from raster images'
            'ffmpeg: Audio tab surround test tones'
            'android-tools: Audio tab phone relay APK install'
            'og-wallpaper: animated wallpapers'
            'og-wallpaper-studio: Theme tab "Open Wallpaper Studio"'
            'og-notify: Notifications tab effects preview'
            'og-bar: Bar tab')
makedepends=('cargo')
# No split -debug package: its RUSTFLAGS path remap differs per package,
# which would make every package rebuild the shared cargo target from
# scratch (and build-repo.sh drops -debug packages anyway).
options=('!debug')
source=()

build() {
  # Builds every packaged app (../workspace-apps) straight from the source
  # tree in one go: all og-* packages share that one build (and, via
  # build-repo.sh, one CARGO_TARGET_DIR), so the 2nd..nth are no-ops.
  local apps=()
  mapfile -t apps < <(grep -v '^#' "$startdir/../workspace-apps")
  cd "$_ogsrc"
  cargo build --release --locked "${apps[@]/#/--package=}"
}

package() {
  install -Dm755 "${CARGO_TARGET_DIR:-$_ogsrc/target}/release/og-settings" "$pkgdir/usr/bin/og-settings"
  install -Dm644 "$_ogsrc/apps/og-settings/packaging/og-settings.desktop" "$pkgdir/usr/share/applications/og-settings.desktop"

  # Runtime helpers og-settings and the seed sway config run by name
  # (resolved via og_config::og_bin: ~/.local/bin dev copy first, then
  # here). Never ~/.local/bin-only: a fresh install has nothing there.
  local s
  for s in og-power-apply og-controller-idle-watch og-opacity-apply; do
    install -Dm755 "$_ogsrc/apps/og-settings/runtime/$s" "$pkgdir/usr/bin/$s"
  done

  # VPN split-tunnel helper: root-owned, not writable by anyone else
  # (750, root:root) and in package territory (/usr/lib, not /usr/local,
  # which pacman doesn't own, and never ~/.local/bin, which a normal user
  # can edit — a NOPASSWD sudoers rule pointing at a user-writable path is
  # a privilege-escalation hole). og-settings falls back to the old
  # /usr/local/bin location only for installs predating this move.
  install -Dm750 -o root -g root "$_ogsrc/apps/og-settings/scripts/og-vpn-apply" "$pkgdir/usr/lib/og-settings/og-vpn-apply"

  # Scoped NOPASSWD entry — the sudoers rule's own path binds it to this
  # exact root-owned file, so widening what a user can run means editing
  # this line, not just editing a script sitting under their own home.
  install -Dm440 "$_ogsrc/apps/og-settings/scripts/og-vpn-sudoers" "$pkgdir/etc/sudoers.d/og-vpn"
}
