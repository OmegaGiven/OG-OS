# Maintainer: OmegaGiven
# Built on the dev machine, not inside the archiso chroot — see
# og-os/OS-PLAN.md phase 2. Sources via rsync from $_ogsrc (the live working tree when built locally, the
# checked-out commit in CI), not git — this is what surfaced the real bug: og-notif-center's
# placement.rs uses ModuleKind::Notifications/Clipboard, which exist in
# OG-toolkit's working tree but weren't committed yet — a git+file://
# clone silently built against the old committed enum and failed.
pkgname=og-notif-center
# Source tree: $OGOS_SRC if set (CI sets it to the checked-out commit),
# else the repo this PKGBUILD lives in. Version: $OGOS_PKGVER if set (CI
# derives a monotonic one from git), else the static fallback below.
_ogsrc="${OGOS_SRC:-$(cd "$startdir/../../.." && pwd)}"
pkgver="${OGOS_PKGVER:-20260908}"
pkgrel=1
pkgdesc="OG-toolkit notification history popup"
arch=('x86_64')
url="https://github.com/OmegaGiven/OG-OS"
license=('MIT')
depends=('gcc-libs' 'wayland')
makedepends=('cargo' 'rsync')
source=()

prepare() {
  rsync -a --exclude target --exclude .git --exclude pkg --exclude distro "$_ogsrc/" "$srcdir/OG-toolkit/"
}

build() {
  cd "$srcdir/OG-toolkit/apps/og-notif-center"
  cargo build --release
}

package() {
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/OG-toolkit/target}/release/og-notif-center" "$pkgdir/usr/bin/og-notif-center"
}
